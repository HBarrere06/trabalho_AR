  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Publicado em 1881, Mem\xF3rias P\xF3stumas de Br\xE1s Cubas \xE9 considerado um dos principais romances de Machado de Assis e um marco do Realismo brasileiro. A hist\xF3ria \xE9 narrada pelo pr\xF3prio Br\xE1s Cubas, que j\xE1 est\xE1 morto quando come\xE7a a contar sua vida.. O protagonista relembra sua inf\xE2ncia, sua juventude, seus relacionamentos e sua tentativa de alcan\xE7ar reconhecimento e import\xE2ncia na sociedade. Entre os epis\xF3dios mais importantes est\xE1 seu relacionamento com Virg\xEDlia, que se torna esposa de outro homem, mas mant\xE9m um caso amoroso secreto com Br\xE1s Cubas."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
