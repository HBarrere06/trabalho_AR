    - target: {fileID: 5802391429320287539, guid: 0e992f680c786a544a6a59f584aa8fe8, type: 3}
      propertyPath: m_Name
      value: brasCanvas
      objectReference: {fileID: 0}
    - target: {fileID: 5802391429320287539, guid: 0e992f680c786a544a6a59f584aa8fe8, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5912806240134061431, guid: 0e992f680c786a544a6a59f584aa8fe8, type: 3}
      propertyPath: m_text
      value: "Publicado em 1881, Mem\xF3rias P\xF3stumas de Br\xE1s Cubas \xE9 considerado um dos principais romances de Machado de Assis e um marco do Realismo brasileiro. A hist\xF3ria \xE9 narrada pelo pr\xF3prio Br\xE1s Cubas, que j\xE1 est\xE1 morto quando come\xE7a a contar sua vida.. O protagonista relembra sua inf\xE2ncia, sua juventude, seus relacionamentos e sua tentativa de alcan\xE7ar reconhecimento e import\xE2ncia na sociedade. Entre os epis\xF3dios mais importantes est\xE1 seu relacionamento com Virg\xEDlia, que se torna esposa de outro homem, mas mant\xE9m um caso amoroso secreto com Br\xE1s Cubas."
      objectReference: {fileID: 0}
    - target: {fileID: 5912806240134061431, guid: 0e992f680c786a544a6a59f584aa8fe8, type: 3}
      propertyPath: m_fontSize
      value: 7
      objectReference: {fileID: 0}
